@page "/tournaments/new"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using TurniejePro.Blazor.Services
@using TurniejePro.Contracts.Auth
@using TurniejePro.Contracts.Tournaments
@implements IDisposable
@inject AuthSession Session
@inject TournamentApiClient TournamentApi

<PageTitle>Nowy turniej</PageTitle>

<h1>Nowy turniej</h1>

@if (!canCreate)
{
    <div class="alert alert-warning" role="alert">
        Tworzenie turnieju wymaga zalogowania. Twórca zostaje jego organizatorem.
    </div>
}
else
{
    @if (successTournament is { } created)
    {
        <div class="alert alert-success" role="status">
            Turniej „@created.Name” został utworzony.
            <a href="teams/register?tournamentId=@created.Id">Zgłoś drużynę do tego turnieju</a>
        </div>
    }

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <EditForm Model="model" OnValidSubmit="HandleValidSubmitAsync" class="col-lg-8">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        <div class="mb-3">
            <label class="form-label" for="tournament-name">Nazwa turnieju</label>
            <InputText id="tournament-name" class="form-control" @bind-Value="model.Name" />
            <ValidationMessage For="() => model.Name" class="text-danger" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="tournament-discipline">Dyscyplina</label>
            <InputSelect id="tournament-discipline" class="form-select" @bind-Value="model.Discipline" @bind-Value:after="ApplyDisciplineDefaultsAsync">
                @foreach (var discipline in DisciplineCatalog.All)
                {
                    <option value="@discipline.Code">@discipline.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="() => model.Discipline" class="text-danger" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="tournament-format">System rozgrywek</label>
            <InputSelect id="tournament-format" class="form-select" @bind-Value="model.Format">
                <option value="@TournamentFormat.League">Liga (każdy z każdym)</option>
                <option value="@TournamentFormat.Cup">Puchar (drabinka)</option>
                <option value="@TournamentFormat.GroupsAndCup">Grupy + puchar (faza grupowa, potem drabinka)</option>
            </InputSelect>
            <ValidationMessage For="() => model.Format" class="text-danger" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="tournament-starts">Termin rozpoczęcia</label>
            <InputDate id="tournament-starts" Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="model.StartsAt" />
            <ValidationMessage For="() => model.StartsAt" class="text-danger" />
        </div>

        <div class="mb-4">
            <label class="form-label" for="tournament-max">Limit drużyn</label>
            <InputNumber id="tournament-max" class="form-control" @bind-Value="model.MaxTeams" />
            <ValidationMessage For="() => model.MaxTeams" class="text-danger" />
        </div>

        <h2 class="h5 mt-4">Punktacja</h2>
        <p class="text-muted small">Wartości domyślne pochodzą z wybranej dyscypliny. Możesz je zmienić.</p>

        <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Gotowe wzorce punktacji">
            @foreach (var preset in ScoringPresets)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" title="@preset.Description" @onclick="() => ApplyPreset(preset)">@preset.Label</button>
            }
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label class="form-label" for="scoring-win">Punkty za wygraną</label>
                <InputNumber id="scoring-win" class="form-control" @bind-Value="model.PointsForWin" />
                <ValidationMessage For="() => model.PointsForWin" class="text-danger" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="scoring-draw">Punkty za remis</label>
                <InputNumber id="scoring-draw" class="form-control" @bind-Value="model.PointsForDraw" disabled="@(!model.AllowDraws)" />
                <ValidationMessage For="() => model.PointsForDraw" class="text-danger" />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="scoring-loss">Punkty za porażkę</label>
                <InputNumber id="scoring-loss" class="form-control" @bind-Value="model.PointsForLoss" />
                <ValidationMessage For="() => model.PointsForLoss" class="text-danger" />
            </div>
        </div>

        <div class="form-check mb-4">
            <InputCheckbox id="scoring-draws" class="form-check-input" @bind-Value="model.AllowDraws" />
            <label class="form-check-label" for="scoring-draws">Remisy są dozwolone</label>
        </div>

        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">Utwórz turniej</button>
    </EditForm>
}

@code {
    private TournamentForm model = CreateDefaultForm();
    private TournamentDetailsResponse? successTournament;
    private string? errorMessage;
    private bool isSubmitting;
    private bool canCreate;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        UpdateAccess();
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;

    private void OnSessionChanged()
    {
        UpdateAccess();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateAccess() => canCreate = Session.IsLoggedIn;

    private async Task HandleValidSubmitAsync()
    {
        var accessToken = Session.Current?.AccessToken;
        if (accessToken is null)
        {
            errorMessage = "Sesja wygasła lub nie jesteś zalogowany. Zaloguj się ponownie.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        successTournament = null;

        try
        {
            // Termin z formularza traktujemy jako czas lokalny i wysyłamy w UTC, zgodnie z kontraktem API.
            var startsAt = new DateTimeOffset(DateTime.SpecifyKind(model.StartsAt, DateTimeKind.Local)).ToUniversalTime();
            var scoring = new ScoringRulesRequest(model.PointsForWin, model.PointsForDraw, model.PointsForLoss, model.AllowDraws);
            var request = new CreateTournamentRequest(model.Name, model.Discipline, model.Format, startsAt, model.MaxTeams, scoring);

            var result = await TournamentApi.CreateTournamentAsync(request, accessToken);
            if (result.Tournament is { } tournament)
            {
                successTournament = tournament;
                model = CreateDefaultForm();
            }
            else
            {
                errorMessage = result.ErrorMessage;
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static TournamentForm CreateDefaultForm() => new()
    {
        Discipline = DisciplineCatalog.All[0].Code,
        Format = TournamentFormat.League,
        StartsAt = DateTime.Now.AddDays(14).Date.AddHours(18),
        MaxTeams = 8,
        PointsForWin = DisciplineCatalog.All[0].PointsForWin,
        PointsForDraw = DisciplineCatalog.All[0].PointsForDraw,
        PointsForLoss = DisciplineCatalog.All[0].PointsForLoss,
        AllowDraws = DisciplineCatalog.All[0].AllowDraws
    };

    // Po zmianie dyscypliny wypełniamy punktację wartościami z katalogu. Organizator może je potem poprawić.
    private Task ApplyDisciplineDefaultsAsync()
    {
        if (DisciplineCatalog.Find(model.Discipline) is { } definition)
        {
            model.PointsForWin = definition.PointsForWin;
            model.PointsForDraw = definition.PointsForDraw;
            model.PointsForLoss = definition.PointsForLoss;
            model.AllowDraws = definition.AllowDraws;
        }

        return Task.CompletedTask;
    }

    // Gotowe wzorce tylko wypełniają pola formularza. Nie są zapisywane w bazie.
    private static readonly ScoringPreset[] ScoringPresets =
    [
        new("Standard 3-1-0", "Wygrana 3, remis 1, porażka 0. Remisy dozwolone.", 3, 1, 0, true),
        new("Bez remisów 3-0-0", "Wygrana 3, porażka 0. Remis niedozwolony (np. dogrywka).", 3, 0, 0, false),
        new("Dwa punkty 2-1-0", "Wygrana 2, remis 1, porażka 0. Remisy dozwolone.", 2, 1, 0, true),
        new("Pucharowy", "Wygrana 3, porażka 0. Bez remisów, jak w drabince.", 3, 0, 0, false)
    ];

    private void ApplyPreset(ScoringPreset preset)
    {
        model.PointsForWin = preset.PointsForWin;
        model.PointsForDraw = preset.PointsForDraw;
        model.PointsForLoss = preset.PointsForLoss;
        model.AllowDraws = preset.AllowDraws;
    }

    private sealed record ScoringPreset(
        string Label,
        string Description,
        int PointsForWin,
        int PointsForDraw,
        int PointsForLoss,
        bool AllowDraws);

    private sealed class TournamentForm
    {
        [Required(ErrorMessage = "Podaj nazwę turnieju.")]
        [StringLength(100, MinimumLength = 3, ErrorMessage = "Nazwa turnieju musi mieć od 3 do 100 znaków.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Podaj dyscyplinę.")]
        [StringLength(50, ErrorMessage = "Dyscyplina może mieć najwyżej 50 znaków.")]
        public string Discipline { get; set; } = string.Empty;

        public TournamentFormat Format { get; set; }

        [Required(ErrorMessage = "Podaj termin rozpoczęcia.")]
        public DateTime StartsAt { get; set; }

        [Range(2, 128, ErrorMessage = "Limit drużyn musi być z zakresu 2–128.")]
        public int MaxTeams { get; set; }

        [Range(0, 99, ErrorMessage = "Punkty muszą być z zakresu 0–99.")]
        public int PointsForWin { get; set; }

        [Range(0, 99, ErrorMessage = "Punkty muszą być z zakresu 0–99.")]
        public int PointsForDraw { get; set; }

        [Range(0, 99, ErrorMessage = "Punkty muszą być z zakresu 0–99.")]
        public int PointsForLoss { get; set; }

        public bool AllowDraws { get; set; } = true;
    }
}
