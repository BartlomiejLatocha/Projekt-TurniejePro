@page "/tournaments/{TournamentId:guid}"
@rendermode InteractiveServer
@using TurniejePro.Blazor.Services
@using TurniejePro.Contracts.Teams
@using TurniejePro.Contracts.Tournaments
@inject TournamentApiClient TournamentApi
@inject TeamApiClient TeamApi
@inject AuthSession Session
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>Turniej</PageTitle>

@if (isLoading)
{
    <p><em>Ładowanie turnieju...</em></p>
}
else if (tournament is null)
{
    <div class="alert alert-warning" role="status">Nie znaleziono turnieju.</div>
}
else
{
    <div class="d-flex align-items-center gap-3 mb-3">
        <span class="tp-discipline-badge"><DisciplineIcon Code="@tournament.Discipline" Size="28" /></span>
        <div>
            <h1 class="h3 mb-0">@tournament.Name</h1>
            <span class="text-muted">@DisciplineCatalog.NameOf(tournament.Discipline) · @FormatName(tournament.Format)</span>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Pobieranie raportu">
        <a class="btn btn-sm btn-outline-secondary" href="@ExportUrl("pdf")">Pobierz PDF</a>
        <a class="btn btn-sm btn-outline-secondary" href="@ExportUrl("csv")">Pobierz CSV</a>
    </div>

    @if (successMessage is not null)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <RoleView RequireOwner="true" Owner="tournament.OrganizerId">
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted mb-3">Panel organizatora</h2>

                @if (managementError is not null)
                {
                    <div class="alert alert-danger" role="alert">@managementError</div>
                }

                <div class="d-flex flex-wrap gap-2 align-items-center">
                    @* Generowanie terminarza rozpoczyna turniej, a rozpoczętego turnieju nie można usunąć (API zwraca błąd). *@
                    @if (confirmAction is null)
                    {
                        @if (canChangeLifecycle)
                        {
                            <button type="button" class="btn btn-primary" disabled="@isBusy" @onclick="() => confirmAction = ManagementAction.Generate">Generuj terminarz</button>
                        }
                        <a class="btn btn-outline-secondary" href="/tournaments/@TournamentId/edit">Edytuj turniej</a>
                        @if (canChangeLifecycle)
                        {
                            <button type="button" class="btn btn-outline-danger" disabled="@isBusy" @onclick="() => confirmAction = ManagementAction.Delete">Usuń turniej</button>
                        }
                    }
                    else
                    {
                        <span class="me-2">@ConfirmText(confirmAction.Value)</span>
                        <button type="button" class="btn btn-danger" disabled="@isBusy" @onclick="ConfirmAsync">Potwierdź</button>
                        <button type="button" class="btn btn-outline-secondary" disabled="@isBusy" @onclick="() => confirmAction = null">Anuluj</button>
                    }
                </div>
            </div>
        </div>
    </RoleView>

    <ul class="nav nav-tabs mb-4" role="tablist">
        @foreach (var tab in Tabs)
        {
            <li class="nav-item" role="presentation">
                <button type="button" role="tab" class="nav-link @(activeTab == tab ? "active" : "")" aria-selected="@(activeTab == tab)" @onclick="() => SelectTab(tab)">@TabName(tab)</button>
            </li>
        }
    </ul>

    @* Klucz wymusza ponowne załadowanie zakładki po zmianie danych (np. po wygenerowaniu terminarza). *@
    <div @key="contentVersion">
    @switch (activeTab)
    {
        case TournamentTab.Info:
            <dl class="row">
                <dt class="col-sm-3">Dyscyplina</dt>
                <dd class="col-sm-9">@DisciplineCatalog.NameOf(tournament.Discipline)</dd>

                <dt class="col-sm-3">System rozgrywek</dt>
                <dd class="col-sm-9">@FormatName(tournament.Format)</dd>

                <dt class="col-sm-3">Termin rozpoczęcia</dt>
                <dd class="col-sm-9">@tournament.StartsAt.ToLocalTime().ToString("g")</dd>

                <dt class="col-sm-3">Limit drużyn</dt>
                <dd class="col-sm-9">@tournament.TeamsCount / @tournament.MaxTeams</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@StatusLabel(tournament.Status)</dd>

                @if (tournament.Format != TournamentFormat.Cup)
                {
                    <dt class="col-sm-3">Punktacja</dt>
                    <dd class="col-sm-9">@ScoringText(tournament.ScoringRules)</dd>
                }
            </dl>
            break;

        case TournamentTab.Teams:
            @if (acceptedTeams.Count == 0)
            {
                <p class="text-muted">Brak zaakceptowanych drużyn.</p>
            }
            else
            {
                <ul class="list-unstyled">
                    @foreach (var team in acceptedTeams)
                    {
                        <li class="d-flex align-items-center gap-2 mb-2">
                            <TeamLogo TeamId="@team.Id" HasLogo="@team.HasLogo" Name="@team.Name" Size="28" />
                            <span>@team.Name</span>
                        </li>
                    }
                </ul>
            }
            break;

        case TournamentTab.Schedule:
            <TournamentSchedule TournamentId="TournamentId" />
            break;

        case TournamentTab.Standings:
            <TournamentStandings TournamentId="TournamentId" />
            break;

        case TournamentTab.Bracket:
            <TournamentBracket TournamentId="TournamentId" />
            break;
    }
    </div>
}

@code {
    [Parameter]
    public Guid TournamentId { get; set; }

    private enum TournamentTab
    {
        Info,
        Teams,
        Schedule,
        Standings,
        Bracket
    }

    private enum ManagementAction
    {
        Generate,
        Delete
    }

    private TournamentDetailsResponse? tournament;
    private IReadOnlyList<TeamResponse> acceptedTeams = [];
    private TournamentTab activeTab = TournamentTab.Info;
    private bool isLoading = true;
    // Plik generuje API (GET /api/v1/tournaments/{id}/export/{format}); odpowiedź ma nagłówek attachment, więc przeglądarka pobiera plik.
    private string ExportUrl(string format) =>
        $"{Configuration["Api:BaseUrl"]?.TrimEnd('/')}/api/v1/tournaments/{TournamentId}/export/{format}";

    private bool canChangeLifecycle => tournament?.Status is TournamentStatus.Draft or TournamentStatus.RegistrationOpen;

    private ManagementAction? confirmAction;
    private bool isBusy;
    private string? managementError;
    private string? successMessage;
    private int contentVersion;

    // Akcje organizatora wymagają potwierdzenia: pierwszy klik pyta, drugi wykonuje.
    private async Task ConfirmAsync()
    {
        var action = confirmAction;
        if (action is null)
        {
            return;
        }

        var accessToken = Session.Current?.AccessToken;
        if (accessToken is null)
        {
            managementError = "Sesja wygasła lub nie jesteś zalogowany. Zaloguj się ponownie.";
            confirmAction = null;
            return;
        }

        isBusy = true;
        managementError = null;
        successMessage = null;

        try
        {
            if (action == ManagementAction.Generate)
            {
                var result = await TournamentApi.GenerateScheduleAsync(TournamentId, accessToken);
                if (result.Schedule is null)
                {
                    managementError = result.ErrorMessage;
                }
                else
                {
                    successMessage = "Terminarz został wygenerowany.";
                    activeTab = TournamentTab.Schedule;
                    contentVersion++;
                }
            }
            else
            {
                var error = await TournamentApi.DeleteTournamentAsync(TournamentId, accessToken);
                if (error is null)
                {
                    Navigation.NavigateTo("/tournaments");
                    return;
                }

                managementError = error;
            }
        }
        finally
        {
            isBusy = false;
            confirmAction = null;
        }
    }

    private static string ConfirmText(ManagementAction action) => action switch
    {
        ManagementAction.Generate => "Wygenerować terminarz dla zaakceptowanych drużyn?",
        ManagementAction.Delete => "Usunąć turniej? Tej operacji nie da się cofnąć.",
        _ => string.Empty
    };

    // Tabela dla ligi i grup, drabinka dla pucharu i grup + pucharu.
    private IReadOnlyList<TournamentTab> Tabs
    {
        get
        {
            var tabs = new List<TournamentTab> { TournamentTab.Info, TournamentTab.Teams, TournamentTab.Schedule };

            if (tournament?.Format is TournamentFormat.League or TournamentFormat.GroupsAndCup)
            {
                tabs.Add(TournamentTab.Standings);
            }

            if (tournament?.Format is TournamentFormat.Cup or TournamentFormat.GroupsAndCup)
            {
                tabs.Add(TournamentTab.Bracket);
            }

            return tabs;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        tournament = await TournamentApi.GetTournamentAsync(TournamentId);

        var teams = await TeamApi.GetTeamsAsync(TournamentId);
        acceptedTeams = (teams ?? Array.Empty<TeamResponse>())
            .Where(t => t.Status == TeamRegistrationStatus.Accepted)
            .ToList();

        isLoading = false;
    }

    private void SelectTab(TournamentTab tab) => activeTab = tab;

    private string TabName(TournamentTab tab) => tab switch
    {
        TournamentTab.Info => "Informacje",
        TournamentTab.Teams => "Drużyny",
        TournamentTab.Schedule => "Terminarz",
        TournamentTab.Standings => tournament?.Format == TournamentFormat.GroupsAndCup ? "Tabela grup" : "Tabela",
        TournamentTab.Bracket => "Drabinka",
        _ => tab.ToString()
    };

    private static string FormatName(TournamentFormat format) => format switch
    {
        TournamentFormat.League => "Liga",
        TournamentFormat.Cup => "Puchar",
        TournamentFormat.GroupsAndCup => "Grupy + puchar",
        _ => format.ToString()
    };

    private static string StatusLabel(TournamentStatus status) => status switch
    {
        TournamentStatus.Draft => "Szkic",
        TournamentStatus.RegistrationOpen => "Zapisy",
        TournamentStatus.InProgress => "W trakcie",
        TournamentStatus.Finished => "Zakończony",
        _ => status.ToString()
    };

    private static string ScoringText(ScoringRulesRequest rules) => rules.AllowDraws
        ? $"wygrana {rules.PointsForWin}, remis {rules.PointsForDraw}, porażka {rules.PointsForLoss}"
        : $"wygrana {rules.PointsForWin}, porażka {rules.PointsForLoss} (bez remisów)";
}
