@page "/login"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using TurniejePro.Blazor.Services
@using TurniejePro.Contracts.Auth
@inject AuthApiClient AuthApi
@inject AuthSession Session
@inject NavigationManager Navigation

<PageTitle>Logowanie</PageTitle>

<h1>Logowanie</h1>

<EditForm Model="model" OnValidSubmit="HandleValidSubmitAsync" class="col-md-6 col-lg-4">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" role="alert" />

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="mb-3">
        <label class="form-label" for="login-email">E-mail</label>
        <InputText id="login-email" class="form-control" @bind-Value="model.Email" autocomplete="username" />
        <ValidationMessage For="() => model.Email" class="text-danger" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="login-password">Hasło</label>
        <InputText id="login-password" type="password" class="form-control" @bind-Value="model.Password" autocomplete="current-password" />
        <ValidationMessage For="() => model.Password" class="text-danger" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">Zaloguj</button>
</EditForm>

@code {
    private LoginModel model = new();
    private string? errorMessage;
    private bool isSubmitting;

    private async Task HandleValidSubmitAsync()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var outcome = await AuthApi.LoginAsync(new LoginRequest(model.Email, model.Password));
            if (outcome.Response is { } auth)
            {
                Session.Start(auth);
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = outcome.ErrorMessage;
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Podaj adres e-mail.")]
        [EmailAddress(ErrorMessage = "Podaj poprawny adres e-mail.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Podaj hasło.")]
        public string Password { get; set; } = string.Empty;
    }
}
