@page "/tournaments"
@rendermode InteractiveServer
@using TurniejePro.Blazor.Services
@using TurniejePro.Contracts.Common
@using TurniejePro.Contracts.Tournaments
@inject TournamentApiClient TournamentApi

<PageTitle>Turnieje</PageTitle>

<h1>Turnieje</h1>

<form class="row g-2 align-items-end mb-4" @onsubmit="SearchAsync" @onsubmit:preventDefault>
    <div class="col-md-8">
        <label class="form-label" for="tournament-search">Szukaj po nazwie lub dyscyplinie</label>
        <input id="tournament-search" class="form-control" type="search" @bind="searchText" @bind:event="oninput" />
    </div>
    <div class="col-md-auto">
        <button type="submit" class="btn btn-primary" disabled="@isLoading">Szukaj</button>
    </div>
</form>

@if (isLoading)
{
    <p><em>Ładowanie turniejów...</em></p>
}
else if (loadFailed)
{
    <div class="alert alert-danger" role="alert">Nie udało się pobrać listy turniejów. Sprawdź połączenie z API.</div>
}
else if (pageResult is null || pageResult.Items.Count == 0)
{
    <p class="text-muted">Brak turniejów do wyświetlenia.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Nazwa</th>
                    <th>Dyscyplina</th>
                    <th>System rozgrywek</th>
                    <th>Termin rozpoczęcia</th>
                    <th>Limit drużyn</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tournament in pageResult.Items)
                {
                    <tr>
                        <td>@tournament.Name</td>
                        <td>@tournament.Discipline</td>
                        <td>@FormatName(tournament.Format)</td>
                        <td>@tournament.StartsAt.ToLocalTime().ToString("g")</td>
                        <td>@tournament.MaxTeams</td>
                        <td>
                            <a href="tournaments/@tournament.Id/schedule">Terminarz</a>
                            <RoleView Roles="Organizer">
                                <a href="tournaments/@tournament.Id/teams">Zgłoszenia</a>
                            </RoleView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <button class="btn btn-outline-secondary" disabled="@(currentPage <= 1)" @onclick="PreviousPageAsync">Poprzednia</button>
        <span>Strona @currentPage z @TotalPages() (łącznie: @pageResult.TotalCount)</span>
        <button class="btn btn-outline-secondary" disabled="@(currentPage >= TotalPages())" @onclick="NextPageAsync">Następna</button>
    </div>
}

@code {
    private const int PageSize = 10;

    private PagedResponse<TournamentResponse>? pageResult;
    private string searchText = string.Empty;
    private string appliedSearch = string.Empty;
    private int currentPage = 1;
    private bool isLoading = true;
    private bool loadFailed;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SearchAsync()
    {
        appliedSearch = searchText.Trim();
        currentPage = 1;
        await LoadAsync();
    }

    private async Task PreviousPageAsync()
    {
        currentPage--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        currentPage++;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadFailed = false;

        pageResult = await TournamentApi.GetTournamentPageAsync(currentPage, PageSize, appliedSearch);
        loadFailed = pageResult is null;

        isLoading = false;
    }

    private int TotalPages() =>
        pageResult is null || pageResult.TotalCount == 0 ? 1 : (int)Math.Ceiling(pageResult.TotalCount / (double)PageSize);

    private static string FormatName(TournamentFormat format) => format switch
    {
        TournamentFormat.League => "Liga",
        TournamentFormat.Cup => "Puchar",
        _ => format.ToString()
    };
}
