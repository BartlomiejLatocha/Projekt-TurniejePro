@page "/"
@rendermode InteractiveServer
@using TurniejePro.Blazor.Services
@inject AuthSession Session

<PageTitle>TurniejePro</PageTitle>

<div class="tp-orb tp-orb-1" aria-hidden="true"></div>
<div class="tp-orb tp-orb-2" aria-hidden="true"></div>
<div class="tp-orb tp-orb-3" aria-hidden="true"></div>

<h1>TurniejePro</h1>

<p class="lead">
    Organizuj amatorskie turnieje bez arkuszy i komunikatorów: zgłoszenia drużyn, terminarz,
    wyniki i tabela w jednym miejscu.
</p>

<RoleView>
    <div class="alert alert-success" role="status">
        Zalogowano jako <strong>@Session.Current?.Email</strong>.
        Role: @string.Join(", ", Session.Current?.Roles ?? [])
    </div>
</RoleView>

<RoleView AnonymousOnly="true">
    <div class="d-flex gap-2 mb-4">
        <a class="btn btn-primary" href="login">Zaloguj się</a>
        <a class="btn btn-outline-primary" href="register">Załóż konto</a>
    </div>
</RoleView>

<section class="tp-steps" aria-label="Jak to działa">
    <div class="tp-step" style="--i: 0">
        <span class="tp-step-num">1</span>
        <div>
            <strong>Organizator zakłada turniej</strong>
            <p>Nazwa, dyscyplina, system rozgrywek, termin i limit drużyn.</p>
        </div>
    </div>
    <div class="tp-step" style="--i: 1">
        <span class="tp-step-num">2</span>
        <div>
            <strong>Drużyny się zgłaszają</strong>
            <p>Kapitan dodaje drużynę i zawodników, organizator akceptuje zgłoszenia.</p>
        </div>
    </div>
    <div class="tp-step" style="--i: 2">
        <span class="tp-step-num">3</span>
        <div>
            <strong>Terminarz powstaje sam</strong>
            <p>Liga każdy z każdym albo drabinka pucharowa z wolnymi losami.</p>
        </div>
    </div>
    <div class="tp-step" style="--i: 3">
        <span class="tp-step-num">4</span>
        <div>
            <strong>Wyniki i tabela</strong>
            <p>Po wpisaniu wyniku tabela i awanse przeliczają się automatycznie.</p>
        </div>
    </div>
</section>

<div class="row row-cols-1 row-cols-md-3 g-3 tp-roles">
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Kibic</h2>
                <p class="card-text">Przeglądaj turnieje, terminarz, wyniki i tabele. Konto nie jest potrzebne do oglądania publicznych danych.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Kapitan</h2>
                <p class="card-text">Zgłoś swoją drużynę i zawodników do otwartego turnieju.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Organizator</h2>
                <p class="card-text">Załóż turniej, zaakceptuj zgłoszenia, wygeneruj terminarz i wpisuj wyniki meczów.</p>
            </div>
        </div>
    </div>
</div>
