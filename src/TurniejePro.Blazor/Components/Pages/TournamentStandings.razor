@page "/tournaments/{TournamentId:guid}/standings"
@rendermode InteractiveServer
@using TurniejePro.Blazor.Services
@using TurniejePro.Contracts.Standings
@using TurniejePro.Contracts.Tournaments
@inject TournamentApiClient TournamentApi

<PageTitle>Tabela</PageTitle>

<h1>@(tournament?.Format == TournamentFormat.GroupsAndCup ? "Tabela grup" : "Tabela ligowa")</h1>

@if (isLoading)
{
    <p><em>Ładowanie tabeli...</em></p>
}
else
{
    @if (tournament is not null)
    {
        <div class="d-flex align-items-center gap-3 mb-3">
            <span class="tp-discipline-badge"><DisciplineIcon Code="@tournament.Discipline" Size="28" /></span>
            <div>
                <h2 class="h4 mb-0">@DisciplineCatalog.NameOf(tournament.Discipline)</h2>
                <span class="text-muted">@tournament.Name</span>
            </div>
        </div>

        @if (tournament.Format != TournamentFormat.Cup)
        {
            var rules = tournament.ScoringRules;
            <p class="text-muted">Punkty: wygrana @rules.PointsForWin, @(rules.AllowDraws ? $"remis {rules.PointsForDraw}, " : "")porażka @rules.PointsForLoss. Przy równej liczbie punktów decyduje bilans bramek, potem bramki zdobyte i mecze bezpośrednie.</p>
        }
    }

    @if (errorMessage is not null)
    {
        <div class="alert alert-warning" role="status">@errorMessage</div>
    }

    @if (tournament?.Format == TournamentFormat.Cup)
    {
        <div class="alert alert-info" role="status">
            Turniej pucharowy nie ma tabeli ligowej. Wyniki i awanse zobacz w <a href="tournaments/@TournamentId/bracket">drabince</a>.
        </div>
    }
    else if (standings is not null)
    {
        @if (standings.Rows.Count == 0)
        {
            <p class="text-muted">Brak zaakceptowanych drużyn w tabeli.</p>
        }
        else
        {
            @foreach (var group in standings.Rows.GroupBy(r => r.Group))
            {
                @if (group.Key is { } groupNumber)
                {
                    <h3 class="h5 mt-4">Grupa @GroupLetter(groupNumber)</h3>
                }

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Miejsce</th>
                            <th>Drużyna</th>
                            <th class="text-center">M</th>
                            <th class="text-center">W</th>
                            <th class="text-center">R</th>
                            <th class="text-center">P</th>
                            <th class="text-center">Bramki</th>
                            <th class="text-center">Bilans</th>
                            <th class="text-center">Pkt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in group)
                        {
                            <tr>
                                <td>@row.Place</td>
                                <td><span class="d-inline-flex align-items-center"><TeamLogo TeamId="@row.TeamId" HasLogo="@row.HasLogo" Name="@row.TeamName" Size="24" />@row.TeamName</span></td>
                                <td class="text-center">@row.Played</td>
                                <td class="text-center">@row.Won</td>
                                <td class="text-center">@row.Drawn</td>
                                <td class="text-center">@row.Lost</td>
                                <td class="text-center">@row.GoalsFor:@row.GoalsAgainst</td>
                                <td class="text-center">@FormatDifference(row.GoalDifference)</td>
                                <td class="text-center"><strong>@row.Points</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            }
        }
    }
}

@code {
    [Parameter]
    public Guid TournamentId { get; set; }

    private TournamentDetailsResponse? tournament;
    private StandingsResponse? standings;
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        tournament = await TournamentApi.GetTournamentAsync(TournamentId);

        var result = await TournamentApi.GetStandingsAsync(TournamentId);
        standings = result.Standings;
        errorMessage = result.ErrorMessage;

        isLoading = false;
    }

    private static string GroupLetter(int group) => ((char)('A' + group - 1)).ToString();

    private static string FormatDifference(int difference) =>
        difference > 0 ? $"+{difference}" : difference.ToString();
}
