@using TurniejePro.Contracts.Tournaments
<svg class="tp-discipline-icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (DisciplineCatalog.Find(Code)?.Code)
    {
        case "football":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 8.5l3.2 2.3-1.2 3.8h-4l-1.2-3.8z" />
            <path d="M12 8.5V3.5M15.2 10.8l4.8-1.6M13.8 14.6l2.9 3.9M10.2 14.6l-2.9 3.9M8.8 10.8l-4.8-1.6" />
            break;
        case "basketball":
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3v18" />
            <path d="M5.6 5.6c3.3 3.3 3.3 9.5 0 12.8M18.4 5.6c-3.3 3.3-3.3 9.5 0 12.8" />
            break;
        case "volleyball":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 3c-2 4-2 14 0 18M3.5 9c4 1.2 12.5 1.2 17 0M4 16c4-1.5 12-1.5 16 0" />
            break;
        case "chess":
            <path d="M12 3a2.5 2.5 0 0 0-1 4.8c-.6.7-1.8 2.2-2.2 4.2h6.4c-.4-2-1.6-3.5-2.2-4.2A2.5 2.5 0 0 0 12 3z" />
            <path d="M8.5 15h7l1 3h-9z" />
            <path d="M6 21h12" />
            break;
        case "esports":
            <path d="M7 9h10a4 4 0 0 1 4 4v1a3 3 0 0 1-5.4 1.8L14 15h-4l-1.6 1.8A3 3 0 0 1 3 14v-1a4 4 0 0 1 4-4z" />
            <path d="M8 11v3M6.5 12.5h3" />
            <path d="M15.5 11.5h.01M17.5 13.5h.01" />
            break;
        default:
            <circle cx="12" cy="12" r="9" />
            <path d="M12 8v4l2.5 1.5" />
            break;
    }
</svg>

@code {
    /// <summary>Kod dyscypliny z <c>DisciplineCatalog</c>.</summary>
    [Parameter]
    public string? Code { get; set; }

    /// <summary>Rozmiar ikony w pikselach.</summary>
    [Parameter]
    public int Size { get; set; } = 24;
}
